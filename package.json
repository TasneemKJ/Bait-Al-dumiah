{
  "name": "bait-al-dumiah",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs && node scripts/check-size.mjs",
    "build:debug": "BAIT_DEBUG=1 node scripts/build.mjs && node scripts/check-size.mjs",
    "verify": "npm run lint && npm test && npm run build",
    "preview": "node scripts/serve.mjs dist",
    "test:browser": "npm run build:debug && python scripts/play_check.py && python scripts/story_smoke.py",
    "lint": "eslint src tests scripts eslint.config.js",
    "test:ui": "npm run build:debug && python scripts/ui_check.py && python scripts/tools_ui_checks.py"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  }
}
